{
  "name": "charactercreator-xr",
  "version": "0.1.0",
  "private": true,
  "description": "WebXR avatar for the CharacterCreator character: VRIK-style IK from head + hands, hand tracking, mirror, in-VR wardrobe.",
  "type": "module",
  "scripts": {
    "sync": "node tools/sync_assets.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "shots": "node tools/emulate_shots.mjs",
    "stage": "node tools/stage_site.mjs",
    "bench": "node --expose-gc --min-semi-space-size=256 --max-semi-space-size=256 tools/bench_ik.mjs"
  },
  "devDependencies": {
    "iwer": "^2.5.0",
    "puppeteer-core": "^25.12.0"
  }
}
